# JWT
# 32자 이상 필수. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Telegram 알림 채널 (선택)
# 비워 두면 서버는 정상 기동하고 알림만 대기 상태로 남는다.
# 발급: 텔레그램에서 @BotFather 에게 /newbot → 발급된 토큰을 여기에 붙여넣는다.
# 자세한 절차는 docs/telegram-alerts.md 참고. 토큰은 절대 공개 저장소에 커밋하지 말 것.
TELEGRAM_BOT_TOKEN=
# 봇 사용자명(@ 제외). 프런트엔드 연동 안내와 t.me 딥링크에 사용된다.
TELEGRAM_BOT_USERNAME=

# Server
API_BASE_URL=https://cantabile.tplinkdns.com
FRONTEND_URL=https://ducklove.github.io/nikon-value
CATALOG_URL=https://ducklove.github.io/nikon-value/data/catalog.json

# Database
DB_PATH=./data/nikon_api.db
