# JWT
# 32자 이상 필수. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 알림 채널 — 텔레그램 봇 토큰 (@BotFather로 생성)
# 미설정 시 발송이 비활성화되고 도달한 알림은 대기 상태로 보존된다.
# 사용자는 봇에게 먼저 말을 건 뒤 chat_id를 PUT /api/channels/telegram으로 등록한다.
TELEGRAM_BOT_TOKEN=

# Server
API_BASE_URL=https://cantabile.tplinkdns.com
FRONTEND_URL=https://ducklove.github.io/nikon-value
CATALOG_URL=https://ducklove.github.io/nikon-value/data/catalog.json

# Database
DB_PATH=./data/nikon_api.db
