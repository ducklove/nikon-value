# JWT
# 32자 이상 필수. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Telegram 알림 채널 (선택)
# 비워 두면 서버는 정상 기동하고 알림만 대기 상태로 남는다.
# 발급: 텔레그램에서 @BotFather 에게 /newbot → 발급된 토큰을 여기에 붙여넣는다.
# 자세한 절차는 docs/telegram-alerts.md 참고. 토큰은 절대 공개 저장소에 커밋하지 말 것.
TELEGRAM_BOT_TOKEN=
# 봇 사용자명(@ 제외). 프런트엔드 연동 안내와 t.me 딥링크에 사용된다.
TELEGRAM_BOT_USERNAME=

# Server
API_BASE_URL=https://cantabile.tplinkdns.com
FRONTEND_URL=https://ducklove.github.io/nikon-value
CATALOG_URL=https://ducklove.github.io/nikon-value/data/catalog.json

# Database
DB_PATH=./data/nikon_api.db

# 리버스 프록시 (선택)
# 앞단에 nginx 등 리버스 프록시를 둔 경우에만, 그 프록시의 IP/CIDR 을 쉼표로 나열한다.
# 이 값이 있을 때에만 rate limit 이 X-Forwarded-For / X-Real-IP 를 클라이언트 IP 로 인정한다.
#
#   비워 둠(기본)  → forwarded 헤더 무시, TCP 피어 주소를 그대로 사용 (프록시 없는 배포에 안전)
#   127.0.0.1      → 같은 장비의 nginx 가 http://127.0.0.1:8000 으로 프록시하는 경우
#   192.168.0.0/24 → 사내망의 별도 프록시 장비
#
# 경고: 프록시가 없는데 이 값을 채우면 누구나 헤더를 위조해 rate limit 을 우회할 수 있다.
# 와일드카드("*")는 지원하지 않는다. 판독/검증 방법은 docs/deploy-api-server.md 참고.
TRUSTED_PROXY_IPS=
