# JWT
# 32자 이상 필수. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Server
API_BASE_URL=https://cantabile.tplinkdns.com
FRONTEND_URL=https://ducklove.github.io/nikon-value
CATALOG_URL=https://ducklove.github.io/nikon-value/data/catalog.json

# Database
DB_PATH=./data/nikon_api.db

# 가격 알림 이메일 (비워 두면 발송 없이 로그만 남는다)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
