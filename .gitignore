# Credentials
ebay.key
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.env

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Config backups (auto-created by admin server)
config/backups/

# Build output
dist/

# Keep data directory structure but ignore contents initially
# (data files are generated by the fetch script and committed by CI)

# Local API server database (contains user accounts)
server/data/

# LLM 판정 캐시: 실행마다 전체 블롭이 바뀌므로 저장소에 넣지 않는다.
# CI에서는 actions/cache로 실행 간 유지된다 (update-prices.yml 참고).
data/llm-cache.json

# 커버리지 산출물
.coverage

# DB 백업 산출물과 rclone 자격증명.
# 기본 경로는 저장소 밖(/var/lib)이지만, 운영자가 --out .으로 저장소 안에서
# 돌릴 수 있으므로 사용자 데이터와 토큰이 커밋되지 않도록 막아 둔다.
*.db.gz
rclone.conf
