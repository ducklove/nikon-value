# nikon-value-backup.service 의 설정 파일 예시.
#
#   sudo cp deploy/nikon-value-backup.env.example /etc/nikon-value-backup.env
#   sudo chmod 600 /etc/nikon-value-backup.env
#   sudo nano /etc/nikon-value-backup.env
#
# systemd 의 EnvironmentFile 이 읽는다. 셸이 아니므로 `export`, 명령 치환($(...)),
# 변수 참조($OTHER)는 동작하지 않는다. 값에 공백이 있으면 따옴표로 감싼다.
#
# 이 파일은 저장소가 아니라 /etc 에 둔다. 텔레그램 봇 토큰이 들어갈 수 있으므로
# 절대 저장소에 커밋하지 말 것(아래 .env.example 만 커밋된다).

# --- 필수 -------------------------------------------------------------------

# 백업할 DB. server/.env 의 DB_PATH 와 같은 값이어야 한다.
NIKON_BACKUP_DB_PATH=/var/lib/nikon-value/nikon_api.db

# 로컬 보관본을 둘 디렉터리. 유닛의 StateDirectory= 가 0700/nikon 소유로 만들어 준다.
# /var/backups/nikon-value 같은 다른 위치를 쓰려면 유닛에
# ReadWritePaths=/var/backups/nikon-value 를 추가하고 디렉터리를 직접 만들어야 한다.
NIKON_BACKUP_DIR=/var/lib/nikon-value-backup

# rclone 원격 경로. 'remote:폴더' 형식이며 폴더를 반드시 지정해야 한다
# (드라이브 루트 `gdrive:` 는 스크립트가 거부한다 — 보관 정리가 루트 전체를 훑게 되므로).
# remote 이름은 `rclone config` 에서 직접 정한 이름이다. 인증 절차는
# docs/backup-restore.md "운영자가 직접 해야 하는 것" 절 참고.
NIKON_BACKUP_REMOTE=gdrive:nikon-value-backup

# --- 보관 정책 (선택) --------------------------------------------------------

# 로컬 보관 일수. 로컬 사본은 "빠른 복원용"이며 SD카드와 운명을 같이하므로 짧게 둔다.
NIKON_BACKUP_KEEP_DAYS=7

# 원격 보관 일수. 뒤늦게 발견한 사고(잘못된 마이그레이션 등)까지 되돌릴 수 있도록
# 로컬보다 훨씬 길게 둔다. 0 으로 두면 원격 정리를 하지 않는다(무한 보관).
NIKON_BACKUP_REMOTE_KEEP_DAYS=30

# --- rclone (선택) -----------------------------------------------------------

# rclone 실행 파일. apt 로 설치했다면 기본값 그대로 두면 된다.
# NIKON_BACKUP_RCLONE=/usr/bin/rclone

# rclone 에 덧붙일 인자. 가정용 회선의 업로드 대역을 백업이 다 먹지 않게 제한한다.
# NIKON_BACKUP_RCLONE_ARGS=--bwlimit=1M --transfers=1 --drive-use-trash=false

# --- 실패 알림 (선택, 그러나 강력히 권장) -------------------------------------
#
# 실패는 종료 코드로도 남지만(= systemctl is-failed), 아무도 안 보면 없는 것과 같다.
# 아래 두 값을 채우면 실패 시 텔레그램으로 알림이 온다.
#
# 토큰은 server/.env 의 TELEGRAM_BOT_TOKEN 과 같은 봇을 그대로 써도 된다
# (백업 스크립트는 server/ 코드를 임포트하지 않고 같은 채널만 재사용한다).
# 자기 chat_id 확인 방법은 docs/backup-restore.md 참고.
# NIKON_BACKUP_TELEGRAM_BOT_TOKEN=
# NIKON_BACKUP_TELEGRAM_CHAT_ID=
