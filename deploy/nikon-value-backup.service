# Nikon Value DB 백업 유닛 (스냅샷 → 검증 → 압축 → 구글 드라이브 업로드)
#
# 설치:
#   sudo cp deploy/nikon-value-backup.service deploy/nikon-value-backup.timer /etc/systemd/system/
#   sudo cp deploy/nikon-value-backup.env.example /etc/nikon-value-backup.env
#   sudo chmod 600 /etc/nikon-value-backup.env && sudo nano /etc/nikon-value-backup.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nikon-value-backup.timer
#
# 이 유닛만 단독으로 한 번 돌려 보려면:
#   sudo systemctl start nikon-value-backup.service
#   journalctl -u nikon-value-backup -n 50 --no-pager
#
# 전제(nikon-value-api.service 와 같다):
#   - 코드      : /opt/nikon-value
#   - 실행 계정 : nikon
#   - DB        : /var/lib/nikon-value/nikon_api.db
#   - 백업/설정 : /var/lib/nikon-value-backup/   (StateDirectory 가 만들어 준다)
#
# rclone 인증 절차와 복원 방법은 docs/backup-restore.md 참고.

[Unit]
Description=Nikon Value DB backup (SQLite snapshot -> gzip -> rclone)
Documentation=file:///opt/nikon-value/docs/backup-restore.md

# 업로드에 아웃바운드 HTTPS 가 필요하다. 타이머의 Persistent=true 때문에 부팅 직후
# 밀린 실행이 도는 경우가 있어 회선이 붙은 뒤에 시작하게 한다.
After=network-online.target
Wants=network-online.target

# 회선이 잠깐 끊긴 정도로 그날 백업을 통째로 포기하지 않도록 몇 번은 다시 시도한다.
# 다만 무한 재시도는 유닛이 failed 로 남지 않게 만들어 `systemctl is-failed` 감시를
# 무력화한다. 1시간 안에 3번 실패하면 재시도를 멈추고 failed 상태로 남긴다.
# (StartLimit* 은 systemd 229 이후 [Service] 가 아니라 [Unit] 에 둔다.)
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=nikon
Group=nikon
WorkingDirectory=/opt/nikon-value

# Type=oneshot 에 허용되는 재시작 정책은 on-failure/on-abort 뿐이다(always/on-success 불가).
Restart=on-failure
RestartSec=10min

# 한 번 실행이 이보다 오래 걸리면 매달려 있는 것으로 보고 죽인다. 업로드 대상이
# 수백 KB 라 정상 실행은 몇 초면 끝난다 — 30분은 회선이 아주 나쁠 때까지 감안한 상한이다.
TimeoutStartSec=30min

# 백업이 API 응답 지연을 만들지 않게 우선순위를 낮춘다. 라즈베리파이에서 gzip 과
# SD카드 쓰기는 체감되는 부하다.
Nice=10
IOSchedulingClass=idle

SyslogIdentifier=nikon-value-backup

# --- 설정 --------------------------------------------------------------------
# 이 스크립트는 python-dotenv 를 쓰지 않는다(표준 라이브러리 전용). 따라서 설정
# 파서는 systemd 의 EnvironmentFile 하나뿐이며, server/.env 와 파서가 겹치지 않는다.
# `-` 접두사를 일부러 붙이지 않았다: 파일이 없으면 기동이 실패한다. 조용히 원격 없이
# 로컬 사본만 만들고 성공한 척하는 것이 이 유닛에서 가장 위험한 실패 모드다.
EnvironmentFile=/etc/nikon-value-backup.env

Environment=PYTHONUNBUFFERED=1
# rclone 은 구글 드라이브 액세스 토큰을 갱신할 때마다 설정 파일을 **다시 쓴다**.
# 따라서 config 는 반드시 쓰기 가능한 위치에 있어야 한다. /opt 는 ProtectSystem=strict
# 로 읽기 전용이고 저장소 안이기도 하므로(실수로 커밋될 위험) StateDirectory 를 쓴다.
Environment=RCLONE_CONFIG=/var/lib/nikon-value-backup/rclone.conf
# rclone 이 $HOME/.cache 를 쓰려다 실패하지 않도록 쓰기 가능한 캐시 위치를 준다.
Environment=XDG_CACHE_HOME=/var/cache/nikon-value-backup

# 스크립트는 표준 라이브러리만 쓰므로 /usr/bin/python3 로도 돌아간다. 서버와 같은
# 인터프리터를 쓰면 파이썬 버전 차이로 인한 놀람이 없어 이쪽을 기본으로 둔다.
ExecStart=/opt/nikon-value/.venv/bin/python /opt/nikon-value/scripts/backup_db.py

# --- 디렉터리 ----------------------------------------------------------------
# nikon-value       : 백업 대상 DB. WAL 을 read-only 로 읽으려면 SQLite 가 같은
#                     디렉터리에 -shm 을 만들 수 있어야 해서 rw 로 붙인다.
#                     (스크립트는 DB 파일 자체를 mode=ro 로 연다.)
# nikon-value-backup: 로컬 보관본과 rclone.conf. DB 디렉터리와 분리해 두면
#                     복원하느라 /var/lib/nikon-value 를 통째로 갈아엎어도
#                     드라이브 인증이 날아가지 않는다.
StateDirectory=nikon-value nikon-value-backup
StateDirectoryMode=0700
CacheDirectory=nikon-value-backup
CacheDirectoryMode=0700
# 백업 파일에는 사용자 계정 정보가 들어 있다. 새로 만드는 파일은 소유자만 읽는다.
UMask=0077

# --- 보안 하드닝 (nikon-value-api.service 와 같은 기준) ------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# 아웃바운드 HTTPS(구글 드라이브, 텔레그램 알림)와 journald 로그 소켓, DNS 조회에
# 필요한 최소 집합.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# MemoryDenyWriteExecute=yes 는 켜지 않는다. rclone 은 Go 로 만들어져 런타임이
# 실행 가능 메모리를 요구하는 경우가 있고, 여기서 막히면 백업이 통째로 멈춘다.

# [Install] 절은 일부러 없다. 이 유닛은 타이머가 부르는 oneshot 이므로 `enable` 대상이
# 아니다. 부팅 시 자동으로 켜야 하는 것은 nikon-value-backup.timer 다.
