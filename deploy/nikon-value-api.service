# Nikon Value API 서버 systemd 유닛 (라즈베리파이 기준)
#
# 설치:
#   sudo cp deploy/nikon-value-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nikon-value-api
#
# 전제(이 값과 다르면 아래 주석을 보고 고칠 것):
#   - 코드      : /opt/nikon-value          (git clone 위치, WorkingDirectory)
#   - 가상환경  : /opt/nikon-value/.venv
#   - 실행 계정 : nikon (비루트 전용 계정)
#   - DB        : /var/lib/nikon-value/nikon_api.db  (StateDirectory 가 만들어 준다)
#   - 리슨      : 127.0.0.1:8000 (앞단 리버스 프록시가 TLS 종료)
#
# 자세한 설치/복구 절차는 docs/deploy-api-server.md 참고.

[Unit]
Description=Nikon Value API (FastAPI/uvicorn)
Documentation=file:///opt/nikon-value/docs/deploy-api-server.md
# 기동 시 카탈로그를 HTTP 로 받아온다. 실패해도 서버는 뜨지만 다음 갱신(1시간)까지
# catalog_loaded=false 로 남으므로, 부팅 시 네트워크가 붙은 뒤 시작하게 한다.
After=network-online.target
Wants=network-online.target

# 5분 안에 5번 넘게 죽으면 재시작을 멈추고 failed 로 남긴다. 설정 오류(.env 누락 등)로
# 영원히 재시작 루프를 도는 대신 상태를 표면화해 `systemctl status` 에서 보이게 한다.
# (systemd 229 이후 이 두 키는 [Service] 가 아니라 [Unit] 에 둔다.)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=nikon
Group=nikon

# uvicorn CLI 는 --app-dir(기본값 ".")을 sys.path 에 넣는다. 따라서 `server.main`
# 임포트는 이 WorkingDirectory 에 의존한다. 경로를 바꾸면 여기도 반드시 바꿀 것.
WorkingDirectory=/opt/nikon-value

# 환경변수는 systemd 의 EnvironmentFile 이 아니라 server/config.py 의 python-dotenv 가
# /opt/nikon-value/server/.env 를 절대경로로 읽어 들인다(파서가 하나뿐이라 따옴표
# 처리 차이로 값이 어긋날 일이 없다). .env 가 없으면 JWT_SECRET_KEY 검증에서
# 즉시 죽으므로 설정 누락이 조용히 넘어가지 않는다.
Environment=PYTHONUNBUFFERED=1

# --no-proxy-headers 를 반드시 붙인다.
# uvicorn 의 프록시 헤더 처리는 기본으로 켜져 있고 --forwarded-allow-ips 기본값이
# 127.0.0.1 이라, 그대로 두면 루프백에서 온 요청의 X-Forwarded-For 를 말없이 신뢰한다.
# 이를 끄면 클라이언트 IP 판정 주체가 server/.env 의 TRUSTED_PROXY_IPS 하나로 모이고,
# 실행 방식(uvicorn 플래그)이 바뀌어도 rate limit 동작이 달라지지 않는다.
# 앱이 X-Forwarded-Proto 를 쓰지 않으므로(모든 외부 URL 은 API_BASE_URL/FRONTEND_URL
# 설정에서 온다) 이 미들웨어를 꺼도 잃는 기능이 없다.
ExecStart=/opt/nikon-value/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --no-proxy-headers
# 리버스 프록시 없이 직접 노출한다면 --host 0.0.0.0 으로 바꾼다.
# 프록시가 있다면 server/.env 의 TRUSTED_PROXY_IPS 를 채워야 rate limit 이 사용자별로
# 갈린다. --forwarded-allow-ips '*' 는 어떤 경우에도 쓰지 말 것(헤더 위조 허용).

# ExecReload 은 일부러 두지 않았다. uvicorn 은 SIGHUP 을 처리하지 않아 기본 동작대로
# 그냥 죽어 버리므로, `systemctl reload` 가 "무중단 재적용"처럼 보이면서 실제로는
# 서비스를 내려 버린다. 설정 변경은 `systemctl restart` 로만 반영한다.
KillSignal=SIGINT
TimeoutStopSec=20

Restart=on-failure
RestartSec=5s

SyslogIdentifier=nikon-value-api

# --- 상태 디렉터리 -----------------------------------------------------------
# /var/lib/nikon-value 를 0700 으로 만들고 User 소유로 맞춘다.
# SQLite 는 WAL 모드라 DB 파일뿐 아니라 같은 디렉터리에 -wal/-shm 파일을 만들고
# 지운다. 따라서 "파일"이 아니라 "디렉터리"가 쓰기 가능해야 한다.
# 체크아웃 바깥에 두었으므로 git pull/재설치가 DB 를 건드릴 수 없다.
# server/.env 에 DB_PATH=/var/lib/nikon-value/nikon_api.db 를 반드시 지정할 것.
StateDirectory=nikon-value
StateDirectoryMode=0700
# DB 에는 사용자 계정·관심목록·텔레그램 연동이 들어 있다. 새로 만드는 파일은
# 소유자만 읽게 한다.
UMask=0077

# --- 보안 하드닝 -------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
# strict = / 전체를 읽기 전용으로 만든다. 위 StateDirectory 는 자동으로 예외가 되어
# 쓰기가 가능하므로 SQLite(WAL 포함)와 충돌하지 않는다.
# 코드를 /home/... 아래에 두었다면 ProtectHome=yes 가 읽기까지 막으므로
# ProtectHome=read-only 로 낮추거나 /opt 로 옮길 것.
# 부수 효과: /opt 가 읽기 전용이라 파이썬이 __pycache__ 를 쓰지 못한다. 파이썬은 이걸
# 조용히 넘기므로 동작에 문제는 없고, 기동이 아주 조금 느려질 뿐이다.
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# 아웃바운드 HTTPS(카탈로그, 텔레그램 API, OAuth 토큰 교환)와 로컬 리슨에 필요한
# 최소 집합. AF_UNIX 는 journald 로그 소켓용, AF_NETLINK 는 glibc 의 getaddrinfo 가
# 사용 가능한 주소 계열을 확인할 때 쓴다(막으면 DNS 조회가 불안정해진다).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# 1024 미만 포트를 바인드하지 않으므로 capability 는 전부 버린다.
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# MemoryDenyWriteExecute=yes 는 켜지 않았다. cryptography/cffi 가 실행 가능 메모리를
# 요구하는 경우가 있어 아키텍처(특히 32비트 armv7)에 따라 기동이 깨질 수 있다.
# 켜고 싶다면 반드시 실제 파이에서 `systemctl restart` 후 /health 까지 확인할 것.

[Install]
WantedBy=multi-user.target
