[Unit]
Description=Nikon Value API Server
After=network.target

[Service]
Type=simple
User=cantabile
WorkingDirectory=/home/cantabile/Works/nikon_value
ExecStart=/home/cantabile/Works/nikon_value/.venv/bin/python -m uvicorn server.main:app \
    --host 127.0.0.1 \
    --port 3380
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
