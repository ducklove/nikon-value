# Nikon Value DB 백업 타이머
#
#   sudo cp deploy/nikon-value-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nikon-value-backup.timer
#   systemctl list-timers nikon-value-backup.timer   # 다음/직전 실행 확인

[Unit]
Description=Daily Nikon Value DB backup
Documentation=file:///opt/nikon-value/docs/backup-restore.md

[Timer]
# 하루 한 번. 근거는 docs/backup-restore.md "주기를 하루로 잡은 이유" 참고.
# 요약하면: 이 DB의 변경은 사람의 로그인·관심목록 조작이라 하루 단위로도 잃는 양이
# 작고, 더 자주 돌리면 SD카드 쓰기와 가정용 회선 업로드만 늘어난다.
# OnCalendar 은 시스템 로컬 시간대 기준이다(파일명 타임스탬프는 UTC 라 다를 수 있다).
OnCalendar=*-*-* 04:20:00

# 정확히 04:20:00 에 몰릴 이유가 없고, 백업 시작이 다른 정각 작업과 겹치면 파이가
# 잠깐 버벅인다. 0~20분 사이로 흩뿌린다.
RandomizedDelaySec=20m

# 파이가 꺼져 있던 동안(정전·재부팅) 지나간 실행을 부팅 후에 따라잡는다.
# 가정용 회선의 라즈베리파이는 실제로 꺼져 있는 시간이 있고, Persistent 가 없으면
# "그날 백업이 그냥 없다"는 상태가 아무 신호 없이 만들어진다. 따라잡기 실행이
# 회선보다 먼저 뜨는 경우는 서비스 쪽 After=network-online.target 과
# Restart=on-failure 가 받아 준다.
Persistent=true

Unit=nikon-value-backup.service

[Install]
WantedBy=timers.target
